# Required: powers moment detection and drafts
OPENAI_API_KEY=
# Optional: override the model (must support images + structured outputs)
OPENAI_MODEL=

# Optional: Supabase for persistence on the deployed site (run supabase/schema.sql first)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Live WhatsApp linking runs locally only. Set to 0 to turn it off.
WHATSAPP_ENABLED=1
# Optional: path to Chrome if it isn't in the default location
CHROME_PATH=
